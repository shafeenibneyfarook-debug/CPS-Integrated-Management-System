# ======================================================
# CPS MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ======================================================
# Required in Vercel Project Settings (Settings -> Environment Variables)

# 1. MongoDB Atlas Connection URI (Required)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cps_db?retryWrites=true&w=majority

# 2. JWT Secret for User Authentication (Required for Production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 3. Firecrawl API Key for Price Scraper (Optional)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# 4. Groq API Key for AI BOQ Estimator (Optional)
GROQ_API_KEY=your_groq_api_key_here

# 5. Frontend API Base URL (Optional - leave empty on Vercel to default to same-origin /api)
# VITE_API_URL=https://your-custom-backend.vercel.app/api
